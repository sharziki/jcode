#!/usr/bin/env python3
"""Append bounded, timestamped JCode hook events."""

import datetime as dt
import fcntl
import json
import os
import subprocess
from pathlib import Path


state = Path.home() / ".local/state"
state.mkdir(parents=True, exist_ok=True)
path = state / "jcode-events.jsonl"

try:
    event = json.loads(os.environ.get("JCODE_HOOK_PAYLOAD") or "{}")
except json.JSONDecodeError:
    event = {"payload_error": "invalid JSON"}

event.setdefault("event", os.environ.get("JCODE_HOOK_EVENT", "unknown"))
event["timestamp"] = dt.datetime.now(dt.timezone.utc).isoformat()

with path.open("a+", encoding="utf-8") as handle:
    fcntl.flock(handle, fcntl.LOCK_EX)
    handle.write(json.dumps(event, separators=(",", ":"), ensure_ascii=False) + "\n")
    handle.flush()
    handle.seek(0)
    lines = handle.readlines()
    if len(lines) > 400_000:
        handle.seek(0)
        handle.truncate()
        handle.writelines(lines[-200_000:])

if event.get("event") == "session_end" and event.get("session_id"):
    receipt = Path.home() / "bin/jcode-task-receipts"
    if receipt.is_file():
        subprocess.run(
            [str(receipt), "--session", str(event["session_id"]), "--write"],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=10,
            check=False,
        )
