[Unit]
Description=Weekly JCode Operator efficiency review
After=jcode-gateway.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=/root
ExecStart=/root/bin/jcode-operator weekly
Nice=10
IOSchedulingClass=idle
UMask=0077
TimeoutStartSec=30min
