[Unit]
Description=JCode Operator outcome ledger and health review
After=jcode-gateway.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=HOME=/root
WorkingDirectory=/root
ExecStart=/root/bin/jcode-operator daily
Nice=10
IOSchedulingClass=idle
UMask=0077
TimeoutStartSec=30min
